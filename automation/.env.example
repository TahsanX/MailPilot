# Same Supabase pooler connection string as backend/.env.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Must be the exact same value as backend/.env's JWT_SECRET, so /api/export can verify the
# tokens the Node API already issues (no separate login for this service).
JWT_SECRET=

# Gemini (same key as backend/.env works fine, or use a separate one).
GEMINI_API_KEY=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Add GOOGLE_REDIRECT_URI as an authorized redirect URI there, and enable the Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-automation-deployment.vercel.app/api/gmail_oauth_callback

# @BotFather on Telegram > /newbot
TELEGRAM_BOT_TOKEN=

# Where the Gmail callback sends the user back to, e.g. https://mail-pilot-mu.vercel.app
# Leave unset and the callback just shows a "you can close this tab" message instead.
FRONTEND_URL=

# Authorizes GET/POST /api/cron. Vercel sends this automatically as
# "Authorization: Bearer <value>" once set as a project env var.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
CRON_SECRET=bolajabena

# Optional: LangSmith tracing (https://smith.langchain.com). Leave unset to disable tracing.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=mailpilot
