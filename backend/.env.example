# Server
NODE_ENV=development
PORT=4000
# Comma separated list of frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Set to true only when running behind a reverse proxy (so rate limits see the real client IP)
TRUST_PROXY=false

# Supabase Postgres: Project settings > Database > Connection string (use the pooler URI)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Lets users load sample dashboard data. Defaults to true outside production.
ALLOW_SAMPLE_DATA=true

# Password reset email (Resend)
RESEND_API_KEY=
MAIL_FROM=MailPilot <onboarding@resend.dev>
OTP_TTL_MINUTES=10

# PDF summaries (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Make.com
# Outbound: custom webhook URL of the scenario that should receive "user.onboarded"
MAKE_WEBHOOK_URL=
# Sent as the x-make-apikey header; set the same key in the Make webhook's API key authentication
MAKE_WEBHOOK_API_KEY=
# Inbound: Make must send this in x-make-apikey when calling /api/webhooks/make/connection (16+ characters)
MAKE_INBOUND_API_KEY=

# Cron queue (serverless deployments only - see vercel.json). Authorizes POST/GET
# /api/cron/process-pending, which summarizes pending PDFs and notifies Make for finished signups.
# Vercel sends this automatically as "Authorization: Bearer <value>" once set as a project env var.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
